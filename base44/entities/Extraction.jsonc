{
  "name": "Extraction",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Auto-generated title for the extraction"
    },
    "source_text": {
      "type": "string",
      "description": "Original pasted content"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "conversation",
        "transcript",
        "note",
        "article",
        "journal",
        "thought_dump",
        "other"
      ],
      "default": "other"
    },
    "source_platform": {
      "type": "string",
      "enum": [
        "ChatGPT",
        "Claude",
        "Gemini",
        "Grok",
        "Manual Entry",
        "Other"
      ],
      "description": "Platform where the source originated"
    },
    "source_thread_title": {
      "type": "string",
      "description": "Title of the original thread or document"
    },
    "source_original_date": {
      "type": "string",
      "format": "date",
      "description": "Original creation date of the source content"
    },
    "source_link": {
      "type": "string",
      "description": "Optional URL link to the original source"
    },
    "core_insight": {
      "type": "string",
      "description": "The central insight extracted"
    },
    "thought_seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        }
      }
    },
    "framework_seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "story_seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "premise": {
            "type": "string"
          },
          "elements": {
            "type": "string"
          }
        }
      }
    },
    "project_implications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "idea": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          }
        }
      }
    },
    "development_signals": {
      "type": "object",
      "description": "Development signals indicating what forms this material could take and the most likely next step",
      "properties": {
        "potential_forms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "most_likely_next_step": {
          "type": "string"
        }
      }
    },
    "quotable_lines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emerging_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_loops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        }
      }
    },
    "suggested_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mira_note": {
      "type": "string",
      "description": "MIRA's observation about this extraction"
    }
  },
  "required": [
    "title",
    "source_text"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}