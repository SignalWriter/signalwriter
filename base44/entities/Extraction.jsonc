{
  "name": "Extraction",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "MIRA-generated Emergence Title \u2014 describes what was discovered"
    },
    "user_alias": {
      "type": "string",
      "description": "Optional user-created nickname or personal title for this extraction"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active",
      "description": "Active extractions appear in main views; archived are hidden but preserved"
    },
    "source_text": {
      "type": "string",
      "description": "Original pasted content"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "conversation",
        "transcript",
        "note",
        "article",
        "journal",
        "thought_dump",
        "other"
      ],
      "default": "other"
    },
    "source_platform": {
      "type": "string",
      "enum": [
        "ChatGPT",
        "Claude",
        "Gemini",
        "Grok",
        "Perplexity",
        "NotebookLM",
        "Obsidian",
        "Manual Entry",
        "Other"
      ],
      "description": "Platform where the source originated"
    },
    "source_thread_title": {
      "type": "string",
      "description": "Title of the original conversation, thread, document, or source location"
    },
    "source_thread_url": {
      "type": "string",
      "description": "Optional share link, browser URL, or source link for the original conversation"
    },
    "source_original_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time the source conversation or extraction moment occurred"
    },
    "source_link": {
      "type": "string",
      "description": "Optional URL link to the original source (legacy field)"
    },
    "core_insight": {
      "type": "string",
      "description": "The central insight extracted"
    },
    "thought_seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        }
      }
    },
    "framework_seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "story_seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "premise": {
            "type": "string"
          },
          "elements": {
            "type": "string"
          }
        }
      }
    },
    "project_implications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "idea": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          }
        }
      }
    },
    "development_signals": {
      "type": "object",
      "description": "Development signals indicating what forms this material could take and the most likely next step",
      "properties": {
        "potential_forms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "most_likely_next_step": {
          "type": "string"
        }
      }
    },
    "quotable_lines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emerging_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_loops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        }
      }
    },
    "suggested_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mira_note": {
      "type": "string",
      "description": "MIRA's observation about this extraction"
    },
    "notes": {
      "type": "array",
      "description": "User notes attached to this extraction \u2014 thoughts, connections, intentions",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "description": "External resources providing context, inspiration, or supporting research",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "resource_type": {
            "type": "string",
            "enum": [
              "Article",
              "Video",
              "Book",
              "Podcast",
              "Website",
              "PDF / Document",
              "Tool / App",
              "Research",
              "Other"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "influenced_projects": {
      "type": "array",
      "description": "Projects, stories, products, or initiatives that emerged from this extraction",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "project_type": {
            "type": "string",
            "enum": [
              "Product",
              "Story",
              "Book",
              "Essay",
              "Course",
              "Business",
              "Framework",
              "Community",
              "Other"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "description": "What became of this discovery \u2014 closes the loop between discovery and execution",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Published",
            "Completed",
            "In Progress",
            "Scheduled",
            "Abandoned",
            "Merged Into Another Project",
            "Archived",
            "Still Exploring"
          ]
        },
        "asset_title": {
          "type": "string"
        },
        "completion_date": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "lessons_learned": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "required": [
    "title",
    "source_text"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}