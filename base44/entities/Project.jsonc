{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Project title"
    },
    "description": {
      "type": "string",
      "description": "What is this project about?"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "dormant",
        "completed",
        "archived"
      ],
      "default": "active"
    },
    "canon_summary": {
      "type": "string",
      "description": "Current living canon summary \u2014 the project's current state of knowledge"
    },
    "canon_entries": {
      "type": "array",
      "description": "Canonical facts, characters, concepts, rules, etc.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "Character",
              "Concept",
              "Terminology",
              "Location",
              "System",
              "Relationship",
              "Rule",
              "Theme",
              "Framework",
              "Other"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "open_threads": {
      "type": "array",
      "description": "Everything still developing \u2014 questions, missing pieces, future conversations",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "suggested_canon_queries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Useful future questions to ask the Canon"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_extraction_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}